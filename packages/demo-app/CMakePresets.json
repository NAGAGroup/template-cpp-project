{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF"
      }
    },
    {
      "name": "default",
      "displayName": "Default (package variant)",
      "inherits": "base"
    },
    {
      "name": "clang",
      "displayName": "Clang (regime guard — toolchain comes from the build env)",
      "inherits": "base",
      "cacheVariables": {
        "DEMO_APP_EXPECT_COMPILER_ID": "Clang"
      }
    },
    {
      "name": "clang-win",
      "displayName": "Clang on Windows (clang-cl — matches demo-app-clang win realization)",
      "inherits": "clang",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl"
      }
    },
    {
      "name": "mingw",
      "displayName": "GNU on Windows (regime guard)",
      "inherits": "base",
      "cacheVariables": {
        "DEMO_APP_EXPECT_COMPILER_ID": "GNU"
      }
    },
    {
      "name": "dev",
      "displayName": "Dev (in-tree)",
      "inherits": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "$env{CONDA_PREFIX}",
        "DEMO_APP_DEV_MODE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    }
  ]
}
