@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
# mathkit is a PUBLIC dependency (appears in our headers).
find_dependency(mathkit)
# spdlog and stb are PRIVATE, but STATIC-library consumers link them
# through $<LINK_ONLY:...> entries in the export set, so we always
# resolve them (and the manifests repeat them as run-deps).
find_dependency(spdlog)
find_dependency(stb)

include("${CMAKE_CURRENT_LIST_DIR}/enginelibTargets.cmake")
check_required_components(enginelib)
