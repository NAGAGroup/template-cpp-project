{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF"
      }
    },
    {
      "name": "default",
      "displayName": "Default (package variant: Release, shared)",
      "inherits": "base"
    },
    {
      "name": "static",
      "displayName": "Static (package variant)",
      "inherits": "base",
      "cacheVariables": {
        "ENGINELIB_SHARED": "OFF"
      }
    },
    {
      "name": "relwithdebinfo",
      "displayName": "RelWithDebInfo (package variant)",
      "inherits": "base",
      "cacheVariables": {
        "ENGINELIB_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "coverage",
      "displayName": "Coverage (package variant, linux, clang)",
      "inherits": "base",
      "cacheVariables": {
        "ENGINELIB_COVERAGE": "ON",
        "ENGINELIB_BUILD_TYPE": "RelWithDebInfo",
        "ENGINELIB_EXPECT_COMPILER_ID": "Clang"
      }
    },
    {
      "name": "dev",
      "displayName": "Dev (in-tree)",
      "inherits": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "$env{CONDA_PREFIX}",
        "ENGINELIB_DEV_MODE": "ON"
      }
    },
    {
      "name": "dev-static",
      "displayName": "Dev static (in-tree)",
      "inherits": [
        "static",
        "dev"
      ]
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "dev-static",
      "configurePreset": "dev-static"
    }
  ]
}
